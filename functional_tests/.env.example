# =============================================================================
# Cluster Service functional test configuration
# Copy to .env and adjust for your environment.
# =============================================================================

# Proto definitions repository
# ВАЖНО: cluster/* protos существуют только на ветке main
# (develop/master не содержат директорию cluster/ вовсе) — переключиться перед прогоном.
PROTO_ROOT=.../proto-repo

# Cluster ports
RAFT_PORT=16330
API_PORT=16331
HC_PORT=16321

# Node Raft IPs (used in bootstrap/join payloads)
NODE01_RAFT_IP=192.168.0.1
NODE02_RAFT_IP=192.168.0.2
NODE03_RAFT_IP=192.168.0.3

# Node health check addresses
NODE01_HC=192.168.1.1
NODE02_HC=192.168.1.2
NODE03_HC=192.168.1.3

# API access via SSH tunnels (defined in ~/.ssh/config)
#   LocalForward 17331 192.168.1.11:16331  (node01)
#   LocalForward 17332 192.168.1.12:16331  (node02)
#   LocalForward 17333 192.168.1.13:16331  (node03)
API_NODE01=localhost:17331
API_NODE02=localhost:17332
API_NODE03=localhost:17333
CLUSTER_API_NODE01=localhost:17331
CLUSTER_API_NODE02=localhost:17332
CLUSTER_API_NODE03=localhost:17333

# Storage heartbeat path — ДОЛЖЕН быть реально смонтированным shared-хранилищем
# на всех нодах одновременно (проверять: `mount | grep sharedfs` на каждой ноде).
STORAGE_HB=../some-storage-system/sharedfs.XXXX-XXXX-XXXXX-XXXX-XXXXXXXXXXXXXXXXXX

# Node SSH access (for fault injection — direct SSH to node IPs)
SSH_USER=root
SSH_NODE01=192.168.0.1
SSH_NODE02=192.168.0.2
SSH_NODE03=192.168.0.3

# Storage IP (iSCSI target — blocked for STOR tests)
STORAGE_IP=192.168.0.20
